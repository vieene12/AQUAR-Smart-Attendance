rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isActiveAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    function isActiveEmployee() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'employee'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    function isActiveKioskOperator() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'manager']
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    function isActiveStaff() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'manager', 'employee']
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'active';
    }

    function validAttendanceLocation() {
      let data = request.resource.data;
      return data.keys().hasAll(['name', 'latitude', 'longitude', 'radiusMeters', 'maxAccuracyMeters'])
        && data.keys().hasOnly(['name', 'latitude', 'longitude', 'radiusMeters', 'maxAccuracyMeters'])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 100
        && data.latitude is number
        && data.latitude >= -90
        && data.latitude <= 90
        && data.longitude is number
        && data.longitude >= -180
        && data.longitude <= 180
        && data.radiusMeters is number
        && data.radiusMeters > 0
        && data.maxAccuracyMeters is number
        && data.maxAccuracyMeters > 0;
    }

    function twoDigits(value) {
      return value < 10 ? '0' + string(value) : string(value);
    }

    function vietnamWorkDate() {
      let localTime = request.time + duration.value(7, 'h');
      return string(localTime.year()) + '-'
        + twoDigits(localTime.month()) + '-'
        + twoDigits(localTime.day());
    }

    function validCheckIn(attendanceId) {
      let data = request.resource.data;
      // 'method' is a client assertion; Rules cannot attest local_auth success.
      return data.keys().hasAll(['employeeId', 'workDate', 'checkInAt', 'method', 'status'])
        && data.keys().hasOnly(['employeeId', 'workDate', 'checkInAt', 'method', 'status'])
        && data.employeeId is string
        && data.employeeId == request.auth.uid
        && data.workDate is string
        && data.workDate == vietnamWorkDate()
        && attendanceId == request.auth.uid + '_' + data.workDate
        && data.checkInAt is timestamp
        && data.checkInAt == request.time
        && data.method == 'biometric'
        && data.status == 'working';
    }

    function validCheckOut(attendanceId) {
      let old = resource.data;
      let updated = request.resource.data;
      let changed = updated.diff(old).affectedKeys();
      return old.keys().hasAll(['employeeId', 'workDate', 'checkInAt', 'method', 'status'])
        && old.keys().hasOnly(['employeeId', 'workDate', 'checkInAt', 'method', 'status',
          'manualRevision', 'lastManualAt', 'lastManualBy'])
        && old.employeeId == request.auth.uid
        && old.workDate is string
        && attendanceId == request.auth.uid + '_' + old.workDate
        && old.checkInAt is timestamp
        && old.method == 'biometric'
        && old.status == 'working'
        && updated.keys().hasAll(['employeeId', 'workDate', 'checkInAt', 'method', 'status', 'checkOutAt'])
        && updated.keys().hasOnly(['employeeId', 'workDate', 'checkInAt', 'method', 'status', 'checkOutAt',
          'manualRevision', 'lastManualAt', 'lastManualBy'])
        && changed.hasOnly(['status', 'checkOutAt'])
        && changed.hasAll(['status', 'checkOutAt'])
        && updated.status == 'completed'
        && updated.checkOutAt is timestamp
        && updated.checkOutAt == request.time
        && updated.checkOutAt >= old.checkInAt;
    }

    function validKioskLink(employeeUid, cardUid) {
      let employeePath = /databases/$(database)/documents/users/$(employeeUid);
      let cardPath = /databases/$(database)/documents/nfc_cards/$(cardUid);
      let linkPath = /databases/$(database)/documents/nfc_employee_cards/$(employeeUid);
      // This proves a current database link, not a physical NFC scan.
      return validNfcUid(cardUid)
        && existsAfter(employeePath)
        && getAfter(employeePath).data.role == 'employee'
        && getAfter(employeePath).data.status == 'active'
        && existsAfter(cardPath)
        && getAfter(cardPath).data.keys().hasAll(['employeeUid', 'createdAt'])
        && getAfter(cardPath).data.keys().hasOnly(['employeeUid', 'createdAt'])
        && getAfter(cardPath).data.employeeUid == employeeUid
        && existsAfter(linkPath)
        && getAfter(linkPath).data.keys().hasAll(['cardUid', 'updatedAt'])
        && getAfter(linkPath).data.keys().hasOnly(['cardUid', 'updatedAt'])
        && getAfter(linkPath).data.cardUid == cardUid;
    }

    function validKioskCheckIn(attendanceId) {
      let data = request.resource.data;
      return data.keys().hasAll(['employeeId', 'workDate', 'checkInAt', 'method', 'status', 'nfcCardUid', 'operatorUid', 'recordedAt'])
        && data.keys().hasOnly(['employeeId', 'workDate', 'checkInAt', 'method', 'status', 'nfcCardUid', 'operatorUid', 'recordedAt'])
        && data.employeeId is string
        && data.nfcCardUid is string
        && data.employeeId != request.auth.uid
        && data.workDate == vietnamWorkDate()
        && attendanceId == data.employeeId + '_' + data.workDate
        && data.checkInAt == request.time
        && data.recordedAt == request.time
        && data.method == 'nfc'
        && data.status == 'working'
        && data.operatorUid == request.auth.uid
        && validKioskLink(data.employeeId, data.nfcCardUid);
    }

    function validKioskCheckOut(attendanceId) {
      let old = resource.data;
      let updated = request.resource.data;
      let changed = updated.diff(old).affectedKeys();
      return old.keys().hasAll(['employeeId', 'workDate', 'checkInAt', 'method', 'status'])
        && ((old.method == 'biometric'
            && old.keys().hasOnly(['employeeId', 'workDate', 'checkInAt', 'method', 'status',
              'manualRevision', 'lastManualAt', 'lastManualBy']))
          || (old.method == 'nfc'
            && old.keys().hasAll(['nfcCardUid', 'operatorUid', 'recordedAt'])
            && old.keys().hasOnly(['employeeId', 'workDate', 'checkInAt', 'method', 'status', 'nfcCardUid', 'operatorUid', 'recordedAt',
              'manualRevision', 'lastManualAt', 'lastManualBy'])
            && old.nfcCardUid is string
            && old.operatorUid is string
            && old.recordedAt is timestamp))
        && old.employeeId is string
        && old.method in ['biometric', 'nfc']
        && old.status == 'working'
        && old.checkInAt is timestamp
        && old.workDate == vietnamWorkDate()
        && attendanceId == old.employeeId + '_' + old.workDate
        && changed.hasAll(['status', 'checkOutAt', 'checkOutMethod', 'checkOutOperatorUid', 'checkOutCardUid', 'checkOutRecordedAt'])
        && changed.hasOnly(['status', 'checkOutAt', 'checkOutMethod', 'checkOutOperatorUid', 'checkOutCardUid', 'checkOutRecordedAt'])
        && updated.status == 'completed'
        && updated.checkOutAt == request.time
        && updated.checkOutAt >= old.checkInAt
        && updated.checkOutMethod == 'nfc'
        && updated.checkOutOperatorUid == request.auth.uid
        && updated.checkOutRecordedAt == request.time
        && updated.checkOutCardUid is string
        && validKioskLink(old.employeeId, updated.checkOutCardUid);
    }

    function dateOfVietnamTime(value) {
      let localTime = value + duration.value(7, 'h');
      return string(localTime.year()) + '-'
        + twoDigits(localTime.month()) + '-'
        + twoDigits(localTime.day());
    }

    function validManualShape(attendanceId) {
      let data = request.resource.data;
      return data.keys().hasAll(['employeeId', 'workDate', 'checkInAt', 'method', 'status', 'manualRevision', 'lastManualAt', 'lastManualBy'])
        && data.keys().hasOnly(['employeeId', 'workDate', 'checkInAt', 'checkOutAt', 'method', 'status',
          'nfcCardUid', 'operatorUid', 'recordedAt', 'checkOutMethod', 'checkOutOperatorUid',
          'checkOutCardUid', 'checkOutRecordedAt', 'manualRevision', 'lastManualAt', 'lastManualBy'])
        && data.employeeId is string
        && data.workDate is string
        && data.workDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && attendanceId == data.employeeId + '_' + data.workDate
        && activeNfcEmployee(data.employeeId)
        && data.checkInAt is timestamp
        && dateOfVietnamTime(data.checkInAt) == data.workDate
        && data.method in ['biometric', 'nfc', 'manual']
        && data.manualRevision is int
        && data.manualRevision > 0
        && data.lastManualAt == request.time
        && data.lastManualBy == request.auth.uid
        && (('checkOutAt' in data)
          ? (data.checkOutAt is timestamp
            && dateOfVietnamTime(data.checkOutAt) == data.workDate
            && data.checkOutAt > data.checkInAt
            && data.status == 'completed')
          : data.status == 'working');
    }

    function matchingManualAudit(attendanceId, before, action) {
      let data = request.resource.data;
      let auditPath = /databases/$(database)/documents/attendance_audit/$(attendanceId + '_' + string(data.manualRevision));
      return !exists(auditPath)
        && existsAfter(auditPath)
        && getAfter(auditPath).data.attendanceId == attendanceId
        && getAfter(auditPath).data.employeeUid == data.employeeId
        && getAfter(auditPath).data.operatorUid == request.auth.uid
        && getAfter(auditPath).data.action == action
        && getAfter(auditPath).data.revision == data.manualRevision
        && getAfter(auditPath).data.before == before
        && getAfter(auditPath).data.after == data
        && getAfter(auditPath).data.createdAt == request.time
        && getAfter(auditPath).data.reason is string
        && getAfter(auditPath).data.reason.size() <= 500
        && getAfter(auditPath).data.reason.matches('.*[^ ].*');
    }

    function validManualCreate(attendanceId) {
      let data = request.resource.data;
      return validManualShape(attendanceId)
        && data.keys().hasOnly(['employeeId', 'workDate', 'checkInAt', 'checkOutAt', 'checkOutMethod',
          'method', 'status', 'manualRevision', 'lastManualAt', 'lastManualBy'])
        && data.method == 'manual'
        && data.manualRevision == 1
        && (('checkOutAt' in data)
          ? data.checkOutMethod == 'manual'
          : !('checkOutMethod' in data))
        && matchingManualAudit(attendanceId, {}, 'create');
    }

    function validManualUpdate(attendanceId) {
      let old = resource.data;
      let data = request.resource.data;
      let changed = data.diff(old).affectedKeys();
      return validManualShape(attendanceId)
        && old.keys().hasAll(['employeeId', 'workDate', 'checkInAt', 'method', 'status'])
        && old.employeeId == data.employeeId
        && old.workDate == data.workDate
        && old.method == data.method
        && old.checkInAt is timestamp
        && old.method in ['biometric', 'nfc', 'manual']
        && (('checkOutAt' in old)
          ? (old.checkOutAt is timestamp && old.status == 'completed'
            && 'checkOutAt' in data
            && (('checkOutMethod' in old)
              ? data.checkOutMethod == old.checkOutMethod
              : !('checkOutMethod' in data)))
          : (old.status == 'working'
            && !('checkOutMethod' in old)
            && (('checkOutAt' in data)
              ? data.checkOutMethod == 'manual'
              : !('checkOutMethod' in data))))
        && changed.hasOnly(['checkInAt', 'checkOutAt', 'checkOutMethod', 'status',
          'manualRevision', 'lastManualAt', 'lastManualBy'])
        && changed.hasAny(['checkInAt', 'checkOutAt'])
        && data.manualRevision == (('manualRevision' in old) ? old.manualRevision + 1 : 1)
        && matchingManualAudit(attendanceId, old,
          (!('checkOutAt' in old) && 'checkOutAt' in data) ? 'add_checkout' : 'adjust');
    }

    function validManualAuditCreate(auditId) {
      let audit = request.resource.data;
      let attendancePath = /databases/$(database)/documents/attendance/$(audit.attendanceId);
      return audit.keys().hasAll(['attendanceId', 'employeeUid', 'operatorUid', 'reason', 'action',
          'revision', 'before', 'after', 'createdAt'])
        && audit.keys().hasOnly(['attendanceId', 'employeeUid', 'operatorUid', 'reason', 'action',
          'revision', 'before', 'after', 'createdAt'])
        && audit.attendanceId is string
        && audit.employeeUid is string
        && audit.operatorUid == request.auth.uid
        && audit.revision is int
        && audit.revision > 0
        && auditId == audit.attendanceId + '_' + string(audit.revision)
        && audit.reason is string
        && audit.reason.size() <= 500
        && audit.reason.matches('.*[^ ].*')
        && audit.before is map
        && audit.after is map
        && audit.createdAt == request.time
        && existsAfter(attendancePath)
        && audit.after == getAfter(attendancePath).data
        && audit.after.employeeId == audit.employeeUid
        && audit.after.manualRevision == audit.revision
        && audit.after.lastManualBy == request.auth.uid
        && audit.after.lastManualAt == request.time
        && (exists(attendancePath)
          ? (audit.before == get(attendancePath).data
            && audit.action == ((!('checkOutAt' in audit.before) && 'checkOutAt' in audit.after)
              ? 'add_checkout' : 'adjust'))
          : (audit.before == {} && audit.action == 'create'));
    }

    function validNewAccount() {
      let data = request.resource.data;
      return data.keys().hasAll(['fullName', 'email', 'role', 'status', 'hourlyRate'])
        && data.keys().hasOnly(['fullName', 'email', 'role', 'status', 'hourlyRate'])
        && data.fullName is string
        && data.fullName.size() > 0
        && data.fullName.size() <= 100
        && data.email is string
        && data.email.size() > 0
        && data.email.size() <= 254
        && data.role in ['manager', 'employee']
        && data.status == 'active'
        && data.hourlyRate is int
        && data.hourlyRate >= 0;
    }

    function validAccountEdit() {
      let data = request.resource.data;
      return resource.data.role in ['manager', 'employee']
        && data.diff(resource.data).affectedKeys().hasOnly(['fullName', 'hourlyRate'])
        && data.fullName is string
        && data.fullName.size() > 0
        && data.fullName.size() <= 100
        && data.hourlyRate is int
        && data.hourlyRate >= 0;
    }

    function validStatusChange(userId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return userId != request.auth.uid
        && resource.data.role in ['manager', 'employee']
        && resource.data.status in ['active', 'locked']
        && changed.hasOnly(['status'])
        && changed.hasAll(['status'])
        && request.resource.data.status in ['active', 'locked'];
    }

    function validNfcUid(cardUid) {
      return cardUid.matches('^([0-9A-F]{2}){1,32}$');
    }

    function activeNfcEmployee(employeeUid) {
      return exists(/databases/$(database)/documents/users/$(employeeUid))
        && get(/databases/$(database)/documents/users/$(employeeUid)).data.role == 'employee'
        && get(/databases/$(database)/documents/users/$(employeeUid)).data.status == 'active';
    }

    function validNfcCard(cardUid) {
      let data = request.resource.data;
      let linkPath = /databases/$(database)/documents/nfc_employee_cards/$(data.employeeUid);
      return validNfcUid(cardUid)
        && data.keys().hasOnly(['employeeUid', 'createdAt'])
        && data.keys().hasAll(['employeeUid', 'createdAt'])
        && data.employeeUid is string
        && activeNfcEmployee(data.employeeUid)
        && data.createdAt == request.time
        && existsAfter(linkPath)
        && getAfter(linkPath).data.cardUid == cardUid;
    }

    function validNfcLink(employeeUid) {
      let data = request.resource.data;
      let cardPath = /databases/$(database)/documents/nfc_cards/$(data.cardUid);
      return activeNfcEmployee(employeeUid)
        && data.keys().hasOnly(['cardUid', 'updatedAt'])
        && data.keys().hasAll(['cardUid', 'updatedAt'])
        && data.cardUid is string
        && validNfcUid(data.cardUid)
        && data.updatedAt == request.time
        && existsAfter(cardPath)
        && getAfter(cardPath).data.employeeUid == employeeUid;
    }

    match /users/{userId} {
      allow get: if request.auth != null
        && (request.auth.uid == userId || isActiveAdmin()
          || (isActiveKioskOperator() && resource.data.role == 'employee'));
      allow list: if isActiveAdmin()
        || (isActiveKioskOperator() && resource.data.role == 'employee');
      allow create: if isActiveAdmin()
        && userId != request.auth.uid
        && validNewAccount();
      allow update: if isActiveAdmin()
        && (validAccountEdit() || validStatusChange(userId));
      allow delete: if false;
    }

    match /nfc_cards/{cardUid} {
      allow get: if isActiveKioskOperator();
      allow list: if isActiveAdmin();
      allow create: if isActiveAdmin() && validNfcCard(cardUid);
      allow update: if false;
      allow delete: if isActiveAdmin()
        && (!existsAfter(/databases/$(database)/documents/nfc_employee_cards/$(resource.data.employeeUid))
          || getAfter(/databases/$(database)/documents/nfc_employee_cards/$(resource.data.employeeUid)).data.cardUid != cardUid);
    }

    match /nfc_employee_cards/{employeeUid} {
      allow get: if isActiveKioskOperator();
      allow list: if isActiveAdmin();
      allow create: if isActiveAdmin() && validNfcLink(employeeUid);
      allow update: if isActiveAdmin()
        && validNfcLink(employeeUid)
        && request.resource.data.cardUid != resource.data.cardUid
        && !existsAfter(/databases/$(database)/documents/nfc_cards/$(resource.data.cardUid));
      allow delete: if isActiveAdmin()
        && !existsAfter(/databases/$(database)/documents/nfc_cards/$(resource.data.cardUid));
    }

    match /attendance/{attendanceId} {
      allow get: if (isActiveEmployee()
        && resource.data.employeeId == request.auth.uid
        && attendanceId == request.auth.uid + '_' + vietnamWorkDate())
        || (isActiveKioskOperator()
          && attendanceId.matches('^.+_[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
      allow list: if isActiveKioskOperator()
        || (isActiveEmployee()
          && resource.data.employeeId == request.auth.uid);
      allow create: if (isActiveEmployee() && validCheckIn(attendanceId))
        || (isActiveKioskOperator() && validKioskCheckIn(attendanceId))
        || (isActiveKioskOperator() && validManualCreate(attendanceId));
      allow update: if (isActiveEmployee() && validCheckOut(attendanceId))
        || (isActiveKioskOperator() && validKioskCheckOut(attendanceId))
        || (isActiveKioskOperator() && validManualUpdate(attendanceId));
      allow delete: if false;
    }

    match /attendance_audit/{auditId} {
      allow get: if isActiveKioskOperator();
      allow list: if false;
      allow create: if isActiveKioskOperator() && validManualAuditCreate(auditId);
      allow update, delete: if false;
    }

    match /company_settings/attendance_location {
      allow get: if isActiveStaff();
      allow list: if false;
      allow create, update: if isActiveAdmin() && validAttendanceLocation();
      allow delete: if false;
    }
  }
}
